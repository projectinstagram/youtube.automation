# ============================================================
# YouTube Shorts Automation - Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.

# ============================================================
# GOOGLE / OAUTH
# ============================================================

# From Google Cloud Console → Credentials → OAuth 2.0 Client
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Must match the redirect URI configured in Google Cloud Console exactly
# Format: https://your-domain.vercel.app/api/auth/google/callback
# For local dev: http://localhost:3000/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# ============================================================
# NVIDIA AI (hosted vision-language models)
# ============================================================

# From https://build.nvidia.com -> API Keys
NVIDIA_API_KEY=your-nvidia-api-key-here

# ============================================================
# SUPABASE
# ============================================================

# From Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# Service Role Key (NOT the anon key - must be server-side only)
# From Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================================
# SECURITY
# ============================================================

# Random secret for cron endpoint protection
# Generate with: openssl rand -hex 32
CRON_SECRET=your-very-long-random-secret-string

# Optional: AES-256 key for encrypting stored tokens
# Generate with: openssl rand -hex 32
# If not set, tokens stored without application-layer encryption
# (Supabase RLS still protects them at the database level)
TOKEN_ENCRYPTION_KEY=your-32-char-encryption-key-here

# ============================================================
# NOTIFICATIONS (Optional)
# ============================================================

# SMTP configuration for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@your-domain.com

# ============================================================
# FEATURE FLAGS
# ============================================================

# Set to 'true' to enable dry run mode globally (no YouTube uploads)
# Also configurable per-run in the database settings
DRY_RUN=false

# ============================================================
# NEXT.JS
# ============================================================

# Only NEXT_PUBLIC_ prefixed vars are exposed to the browser.
# All secrets above must NOT use this prefix.
NEXTAUTH_URL=https://your-domain.vercel.app
